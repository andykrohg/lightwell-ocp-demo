# Lightwell OCP Demo — Environment Configuration
# Copy to demo.env and fill in values before running scripts/deploy-demo.sh
#
# Cluster-specific values (TPA URLs, ACS endpoints, OCP console) are
# auto-detected via oc. You must be logged into the cluster first.

# Required: ACS API token (Central -> Platform Configuration -> Integrations -> API Token)
ROX_API_TOKEN=

# Optional: override defaults
# DEMO_NAMESPACE=lightwell-demo
# TPA_NAMESPACE=tpa-system
